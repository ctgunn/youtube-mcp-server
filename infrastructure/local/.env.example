## override values for hosted-like local verification only.
## Use these with LOCAL_SESSION_MODE=hosted bash scripts/dev_local.sh.
LOCAL_SESSION_MODE=hosted
LOCAL_REDIS_PORT=6379
MCP_ENVIRONMENT=dev
MCP_SESSION_BACKEND=redis
MCP_SESSION_STORE_URL=redis://127.0.0.1:6379/0
MCP_SESSION_CONNECTIVITY_MODEL=local_docker_compose
MCP_SESSION_DURABILITY_REQUIRED=true
MCP_SESSION_TTL_SECONDS=1800
MCP_SESSION_REPLAY_TTL_SECONDS=300
