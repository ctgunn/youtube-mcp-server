# Local runtime environment variables
# Copy this file to .env.local before using bash scripts/dev_local.sh.
# Keep real credentials only in the ignored .env.local file.

# Baseline local runtime defaults: runtime metadata
MCP_ENVIRONMENT=dev
MCP_SERVER_VERSION=0.1.0
MCP_BUILD_ID=local-dev
MCP_BUILD_COMMIT=local
MCP_BUILD_TIME=2026-03-29T00:00:00Z

# Baseline local runtime defaults: local secrets/runtime credentials
YOUTUBE_API_KEY=
YOUTUBE_OAUTH_TOKEN=
MCP_AUTH_TOKEN=
MCP_SECRET_ACCESS_MODE=env_only
MCP_SECRET_REFERENCE_NAMES=
PUBLIC_INVOCATION_INTENT=private_only

# Baseline local runtime defaults: local MCP security defaults
MCP_AUTH_REQUIRED=false
MCP_ALLOWED_ORIGINS=http://localhost:3000
MCP_ALLOW_ORIGINLESS_CLIENTS=true

# Baseline local runtime defaults: local session defaults
MCP_SESSION_BACKEND=memory
MCP_SESSION_STORE_URL=
MCP_SESSION_CONNECTIVITY_MODEL=local_process
MCP_SESSION_DURABILITY_REQUIRED=false
MCP_SESSION_TTL_SECONDS=1800
MCP_SESSION_REPLAY_TTL_SECONDS=300

# Baseline local runtime defaults: local host/runtime settings
HOST=0.0.0.0
PORT=8080
PYTHONPATH=src
LOCAL_REDIS_PORT=6379

# Hosted-like local overrides:
# Set LOCAL_SESSION_MODE=hosted when running bash scripts/dev_local.sh to switch
# to the Redis-backed local verification profile without changing this baseline.
LOCAL_SESSION_MODE=hosted
